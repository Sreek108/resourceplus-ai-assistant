RP_BASE_URL=https://app.resourceplus.app/Mobile/
RP_INSTANCE=Universal
RP_DEFAULT_EMAIL=
RP_DEFAULT_LANG=1
RP_TIMEOUT_SECONDS=20

# Demo frontend identity transport. Configure both or neither. These values are
# not production authentication and are included in the browser build.
VITE_RP_EMAIL=
VITE_RP_INSTANCE=

OPENAI_API_KEY=
OPENAI_MODEL=

CONFIRMATION_TTL_SECONDS=300
SESSION_TTL_SECONDS=1800
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Temporary HTTPS origins only, comma-separated. Keep blank outside an active UAT.
UAT_ALLOWED_ORIGINS=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_EN_LOCALE=en-US
AZURE_SPEECH_AR_LOCALE=ar-SA
AZURE_SPEECH_EN_VOICE=
# Allowed Arabic TTS voices: ar-SA-ZariyahNeural or ar-SA-HamedNeural.
AZURE_SPEECH_AR_VOICE=ar-SA-ZariyahNeural

# Conversation audit is disabled and content-free by default. Enable only under
# an approved local/UAT privacy policy.
AI_AUDIT_ENABLED=false
AI_AUDIT_STORE_CONTENT=false
AI_AUDIT_RETENTION_DAYS=7
AI_AUDIT_DB_PATH=data/assistant_audit.db
AI_AUDIT_DEBUG_ENDPOINT_ENABLED=false

# Safe deployment metadata captured with every new interaction.
APP_VERSION=0.2.0
GIT_COMMIT=unknown
DEPLOYMENT_ID=local
APP_ENVIRONMENT=local

# Vendor-neutral centralized observability handoff. No external exporter is
# enabled by this application unless explicitly implemented/configured.
OBSERVABILITY_EXPORTER=none
OBSERVABILITY_ENDPOINT=
FRONTEND_TELEMETRY_RATE_LIMIT_PER_MINUTE=120

# Optional operations diagnostics remain unavailable unless both values are set.
OPS_DIAGNOSTICS_ENABLED=false
OPS_DIAGNOSTICS_TOKEN=

# Reserved for a later production-authentication milestone; currently unused.
BACKEND_API_KEY=
