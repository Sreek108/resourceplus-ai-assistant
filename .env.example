RP_BASE_URL=https://app.resourceplus.app/Mobile/

# Local/test fallback only.
# UAT requests should carry email + instance from the logged-in ResourcePlus frontend.
RP_INSTANCE=
RP_DEFAULT_EMAIL=

RP_DEFAULT_LANG=1
RP_TIMEOUT_SECONDS=20

# Do not use hard-coded browser identity in UAT/production.
# Frontend should send the currently logged-in user's email + instance.
VITE_RP_EMAIL=
VITE_RP_INSTANCE=

OPENAI_API_KEY=<SERVER_SECRET>
OPENAI_MODEL=<YOUR_CONFIGURED_MODEL>

CONFIRMATION_TTL_SECONDS=300
SESSION_TTL_SECONDS=1800

# Add the actual ResourcePlus frontend origin.
CORS_ALLOWED_ORIGINS=https://app.resourceplus.app

# Only use this if you have another temporary HTTPS UAT frontend origin.
UAT_ALLOWED_ORIGINS=

AZURE_SPEECH_KEY=<SERVER_SECRET>
AZURE_SPEECH_REGION=<YOUR_AZURE_REGION>
AZURE_SPEECH_EN_LOCALE=en-US
AZURE_SPEECH_AR_LOCALE=ar-SA
AZURE_SPEECH_EN_VOICE=en-US-AvaNeural
AZURE_SPEECH_AR_VOICE=ar-SA-ZariyahNeural

# Keep audit content disabled on the server.
AI_AUDIT_ENABLED=true
AI_AUDIT_STORE_CONTENT=false
AI_AUDIT_RETENTION_DAYS=7
AI_AUDIT_DB_PATH=data/assistant_audit.db
AI_AUDIT_DEBUG_ENDPOINT_ENABLED=false

# Update these after the final commit/tag.
APP_VERSION=1.0.1-uat
GIT_COMMIT=<ACTUAL_COMMIT_SHA>
DEPLOYMENT_ID=resourceplus-uat-01
APP_ENVIRONMENT=uat

OBSERVABILITY_EXPORTER=none
OBSERVABILITY_ENDPOINT=
FRONTEND_TELEMETRY_RATE_LIMIT_PER_MINUTE=120

OPS_DIAGNOSTICS_ENABLED=false
OPS_DIAGNOSTICS_TOKEN=

# Reserved for later production authentication.
BACKEND_API_KEY=